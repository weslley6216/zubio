POSTGRES_HOST=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Required only for `bin/kamal deploy` (Supabase production database password).
ZUBIO_DATABASE_PASSWORD=

# Transactional email (Resend HTTP API). Only used in production —
# development and test deliver via :test and never call Resend.
RESEND_API_KEY=
MAILER_FROM=no-reply@zubio.com.br
APP_HOST=zubio.com.br

POSTGRES_HOST=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Supabase production database password. Only used in production.
ZUBIO_DATABASE_PASSWORD=

# Transactional email (Resend HTTP API). Only used in production —
# development and test deliver via :test and never call Resend.
RESEND_API_KEY=
MAILER_FROM=no-reply@zubio.com.br
APP_HOST=zubio.com.br

# Supabase Storage (S3-compatible endpoint). Only used in production —
# development and test keep uploads on local disk.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_BUCKET=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

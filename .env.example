POSTGRES_HOST=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Supabase production database password. Only used in production.
ZUBIO_DATABASE_PASSWORD=

# Transactional email (Resend HTTP API). Only used in production —
# development and test deliver via :test and never call Resend.
RESEND_API_KEY=
MAILER_FROM=no-reply@zubio.com.br
APP_HOST=zubio.com.br

# Custom domains for tenants via Cloudflare for SaaS (Custom Hostnames).
# Only used in production — development and test stub the API via webmock.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_FALLBACK_ORIGIN=fallback.zubio.com.br
